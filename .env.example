# .env 示例（生产别把真值写进仓库）
# 对话 + 转写：主站 AI 网关
ZX_AI_GATEWAY_URL=http://app:3000/api/ai/v1
VOICE_AI_TOKEN=zxai_xxx
# 绑定 SiliconFlow 音频密钥的转写令牌（留给网关路由；缺省用 VOICE_AI_TOKEN）
VOICE_ASR_TOKEN=
VOICE_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
VOICE_MODEL=deepseek-v4.1-flash

# 转写直连（本地/未配网关音频密钥时用；容器部署建议留空走网关）
VOICE_ASR_BASE_URL=
VOICE_ASR_KEY=

# TTS：off / direct / gateway
VOICE_TTS_MODE=direct
VOICE_TTS_BASE_URL=https://api.siliconflow.cn/v1
VOICE_TTS_KEY=sk-xxx
VOICE_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
VOICE_TTS_VOICE=anna
VOICE_TTS_DAILY_CHARS=80000

PORT=8795
VOICE_MAX_ASR_SECONDS=60
